{
  "name": "@second-brain/worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node src/index.ts",
    "indexing:drain": "ts-node src/drain-indexing.ts",
    "indexing:reset-retries": "ts-node src/reset-indexing-retries.ts",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc",
    "start": "node dist/index.js",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "@napi-rs/canvas": "^0.1.80",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@second-brain/ai": "workspace:*",
    "@second-brain/db": "workspace:*",
    "@second-brain/shared": "workspace:*",
    "@sentry/node": "^10.69.0",
    "@supabase/supabase-js": "^2.108.1",
    "dotenv": "^17.4.2",
    "fluent-ffmpeg": "^2.1.3",
    "googleapis": "^171.4.0",
    "node-cron": "^4.2.1",
    "pdfjs-dist": "~6.3.289",
    "pg": "^8.20.0",
    "sharp": "0.35.4",
    "tesseract.js": "^7.0.0",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^5.0.0"
  }
}
