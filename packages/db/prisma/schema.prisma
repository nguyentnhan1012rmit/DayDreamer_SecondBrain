// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector] // Enables pgvector extension
}

// schema.prisma

model CalendarEvent {
  id          String   @id @default(uuid())
  user_id     String
  external_id String // Google Calendar Event ID, unique per user
  title       String
  start_time  DateTime
  end_time    DateTime

  description String? @db.Text
  html_link   String?
  content_hash String?


  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  user        User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  diary_entry DiaryEntry[]

  @@unique([user_id, external_id], map: "calendar_events_user_external_key")
  @@index([user_id, start_time], map: "calendar_events_user_start_time_idx")
  @@map("calendar_events")
}

model GoogleContact {
  id             String   @id @default(uuid())
  user_id        String
  external_id    String
  display_name   String
  email_addresses String[] @default([])
  phone_numbers   String[] @default([])
  organizations   String[] @default([])
  photo_url       String?
  raw_json        Json?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, external_id], map: "google_contacts_user_external_key")
  @@index([user_id, display_name], map: "google_contacts_user_display_name_idx")
  @@map("google_contacts")
}

model GoogleDriveFile {
  id             String   @id @default(uuid())
  user_id        String
  external_id    String
  name           String
  mime_type      String
  web_view_link  String?
  icon_link      String?
  thumbnail_link String?
  size           BigInt?
  modified_time  DateTime?
  extracted_text String?  @db.Text
  content_hash   String?
  extraction_status String @default("pending")
  extraction_completeness Float?
  extraction_error String? @db.Text
  extraction_attempts Int @default(0)
  extraction_updated_at DateTime?
  raw_json       Json?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, external_id], map: "google_drive_files_user_external_key")
  @@index([user_id, modified_time], map: "google_drive_files_user_modified_time_idx")
  @@index([user_id, extraction_status], map: "google_drive_files_user_extraction_status_idx")
  @@map("google_drive_files")
}

model GoogleConnection {
  id            String    @id @default(uuid())
  user_id       String
  source        String
  connected     Boolean   @default(false)
  scopes        String[]  @default([])
  last_sync_at  DateTime?
  last_error    String?   @db.Text
  last_error_at DateTime?
  sync_cursor   Json?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, source], map: "google_connections_user_source_key")
  @@index([user_id, connected], map: "google_connections_user_connected_idx")
  @@map("google_connections")
}

model Summary {
  id           String   @id @default(uuid())
  user_id      String
  summary_type String // 'daily', 'weekly', 'monthly', 'yearly'
  period_start DateTime
  period_end   DateTime
  content      String   @db.Text
  source_version BigInt @default(0)
  dirty          Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  // Relations
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, summary_type, period_start, period_end], map: "summaries_user_type_period_key")
  @@index([user_id, period_start], map: "summaries_user_period_start_idx")
  @@index([dirty, period_end], map: "summaries_dirty_period_end_idx")
  @@map("summaries")
}

model EntityMention {
  id                      String @id @default(uuid())
  chunk_id                String
  entity_type             String // e.g., 'person', 'project', 'goal', 'habit'
  entity_value            String
  entity_value_normalized String?

  created_at DateTime @default(now())

  // Relations
  chunk MemoryChunk @relation(fields: [chunk_id], references: [id], onDelete: Cascade)

  @@unique([chunk_id, entity_type, entity_value], map: "entity_mentions_chunk_type_value_key")
  @@index([entity_type, entity_value], map: "entity_mentions_type_value_idx")
  @@index([entity_type, entity_value_normalized], map: "entity_mentions_type_normalized_value_idx")
  @@index([chunk_id], map: "entity_mentions_chunk_id_idx")
  @@map("entity_mentions")
}

model GmailMessage {
  id          String   @id @default(uuid())
  user_id     String
  external_id String // Gmail Message ID, unique per user
  thread_id   String?
  sender      String
  subject     String
  snippet     String?
  body        String   @db.Text
  received_at DateTime?
  history_id  String?
  content_hash String?
  raw_json    Json?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, external_id], map: "gmail_messages_user_external_key")
  @@index([user_id, received_at], map: "gmail_messages_user_received_at_idx")
  @@map("gmail_messages")
}

// Update your User model to include these relations
model User {
  id               String  @id @default(uuid())
  supabaseId       String  @unique @db.Uuid // Links to auth.users in Supabase
  email            String  @unique
  display_name     String?
  role             String  @default("user")
  google_connected Boolean @default(false) // Tracks OAuth status
  memory_revision  BigInt  @default(0)

  // OAuth Tokens (Needed for your calendar/gmail sync jobs)
  google_access_token  String?
  google_refresh_token String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  diary_entries   DiaryEntry[]
  memory_chunks   MemoryChunk[]
  summaries       Summary[]
  calendar_events CalendarEvent[]
  google_contacts GoogleContact[]
  google_drive_files GoogleDriveFile[]
  google_connections GoogleConnection[]
  gmail_messages  GmailMessage[]
  search_history  SearchHistory[]
  indexing_outbox IndexingOutbox[]

  @@index([role], map: "users_role_idx")
  @@map("users")
}

model DiaryEntry {
  id         String   @id @default(uuid())
  user_id    String
  entry_date DateTime @default(now())
  raw_text   String   @db.Text
  status     String   @default("draft") // e.g., draft, published
  mood       String?
  tags       String[] @default([])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  user            User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  attachments     Attachment[]
  calendar_events CalendarEvent[] // Linked events from your matching logic

  @@index([user_id, entry_date(sort: Desc)], map: "diary_entries_user_entry_date_idx")
  @@index([user_id, created_at(sort: Desc), id(sort: Desc)], map: "diary_entries_user_created_id_idx")
  @@map("diary_entries")
}

model Attachment {
  id             String  @id @default(uuid())
  diary_entry_id String
  storage_path   String
  file_type      String
  extracted_text String? @db.Text
  content_hash   String?
  extraction_status String @default("pending")
  extraction_completeness Float?
  extraction_error String? @db.Text
  extraction_attempts Int @default(0)
  extraction_updated_at DateTime?

  created_at DateTime @default(now())

  // Relations
  diary_entry DiaryEntry @relation(fields: [diary_entry_id], references: [id], onDelete: Cascade)

  @@map("attachments")
}

model SearchHistory {
  id               String   @id @default(uuid())
  user_id          String
  question         String   @db.Text
  answer           String   @db.Text
  confidence       String   // 'high', 'medium', 'low'
  sources_json     String?  @db.Text // Serialized citation array
  analytics_json   String?  @db.Text // Serialized analytics object
  response_language String  @default("en")
  token_count      Int      @default(0)

  created_at DateTime @default(now())
  expires_at DateTime // Cache TTL (e.g. created_at + 24h)

  // Relations
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at(sort: Desc)], map: "search_history_user_created_idx")
  @@index([user_id, question], map: "search_history_user_question_idx")
  @@index([expires_at], map: "search_history_expires_at_idx")
  @@map("search_history")
}

model IndexingOutbox {
  id          String   @id @default(uuid())
  user_id     String
  job_type    String
  source_type String
  source_id   String
  status      String   @default("pending")
  retry_count Int      @default(0)
  max_retries Int      @default(3)
  error       String?  @db.Text
  payload     Json?
  generation  Int      @default(1)
  run_after   DateTime @default(now())
  locked_at   DateTime?
  locked_by   String?  @db.VarChar(128)
  processed_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([job_type, source_type, source_id], map: "indexing_outbox_job_source_key")
  @@index([status, run_after, created_at], map: "indexing_outbox_status_run_after_idx")
  @@index([user_id, status, created_at], map: "indexing_outbox_user_status_created_idx")
  @@index([status, processed_at], map: "indexing_outbox_status_processed_at_idx")
  @@map("indexing_outbox")
}

model StorageDeletionOutbox {
  id            String   @id @default(uuid())
  user_id       String?
  bucket        String
  storage_path  String
  status        String   @default("pending")
  retry_count   Int      @default(0)
  max_retries   Int      @default(10)
  error         String?  @db.Text
  run_after     DateTime @default(now())
  processed_at  DateTime?
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now()) @updatedAt

  @@unique([bucket, storage_path], map: "storage_deletion_outbox_bucket_path_key")
  @@index([status, run_after, created_at], map: "storage_deletion_outbox_status_run_after_idx")
  @@map("storage_deletion_outbox")
}

model WorkerHeartbeat {
  id          String   @id
  status      String   @default("running")
  detail      String?  @db.Text
  startedAt   DateTime @default(now()) @map("started_at")
  heartbeatAt DateTime @default(now()) @map("heartbeat_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([heartbeatAt], map: "worker_heartbeats_heartbeat_at_idx")
  @@map("worker_heartbeats")
}

model MemoryChunk {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  sourceType String   @map("source_type") // e.g., 'diary', 'calendar', 'gmail', 'attachment'
  sourceId   String   @map("source_id") // ID of the original record
  chunkIndex Int      @map("chunk_index")
  chunkType  String   @default("general_note") @map("chunk_type")
  text       String   @db.Text
  evidence   String?  @db.Text
  metadata   Json?
  searchDocument Unsupported("tsvector")? @map("search_document")
  occurredAt DateTime @default(now()) @map("occurred_at")
  embedding  Unsupported("vector(768)")?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity_mentions EntityMention[]

  @@index([userId, sourceType, sourceId], map: "memory_chunks_user_source_idx")
  @@index([userId, occurredAt], map: "memory_chunks_user_occurred_at_idx")
  @@unique([userId, sourceType, sourceId, chunkIndex], map: "memory_chunks_user_source_chunk_key")
  @@map("memory_chunks")
}
