# Copy this file to .env or export these variables before running docker compose.
# Keep real secrets out of git.

# Public frontend build/runtime env
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Runtime secrets for API and worker
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PROJECT_ID=your-supabase-project-id
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
# Optional after fully migrating Auth to asymmetric ES256 signing keys.
SUPABASE_JWT_SECRET=your-legacy-supabase-jwt-secret
# Use a backend-only sb_secret key where available; legacy service_role also works.
SUPABASE_SERVICE_KEY=your-supabase-secret-key
AUTH_REQUIRE_EMAIL_VERIFIED=true
ADMIN_REQUIRE_EMAIL_VERIFIED=true
ADMIN_EMAILS=owner@example.com,teammate@example.com

TUTURUUU_AI_API_KEY=your-tuturuuu-ai-key
TUTURUUU_AI_BASE_URL=https://ai.tuturuuu.com/v1
TUTURUUU_EMBEDDING_MODEL=google/gemini-embedding-2
TUTURUUU_ANSWER_MODEL=google/gemini-3.5-flash-lite
TUTURUUU_CHUNK_MODEL=google/gemini-3.5-flash-lite
TUTURUUU_SUMMARY_MODEL=google/gemini-3.5-flash-lite
TUTURUUU_VISION_MODEL=google/gemini-3.5-flash-lite
TUTURUUU_TRANSCRIPTION_MODEL=google/gemini-3.5-flash-lite
AUDIO_TRANSCRIPTION_PROVIDER=local
AUDIO_TRANSCRIPTION_MAX_DURATION_SECONDS=1800
AUDIO_TRANSCRIPTION_FFMPEG_TIMEOUT_MS=120000
AUDIO_TRANSCRIPTION_MAX_OUTPUT_TOKENS=6000
PDF_OCR_MAX_PAGES=30
PDF_OCR_MIN_TEXT_CHARACTERS=40

# Reliable indexing leases and PostgreSQL LISTEN reconnects.
INDEXING_WORKER_BATCH_SIZE=2
INDEXING_LEASE_TIMEOUT_MS=300000
INDEXING_LEASE_RENEW_INTERVAL_MS=30000
INDEXING_AUTOMATIC_DRAIN_MAX_BATCHES=20
INDEXING_LISTENER_RECONNECT_BASE_MS=1000
INDEXING_LISTENER_RECONNECT_MAX_MS=60000

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/calendar/oauth/callback
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
GOOGLE_OAUTH_STATE_SECRET=replace-with-a-long-random-secret
GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-a-32-byte-base64-or-hex-key
GOOGLE_STORE_RAW_PAYLOADS=false
GOOGLE_GMAIL_BODY_MAX_CHARS=20000

# Production rate limiting and proxy identity.
REDIS_URL=redis://redis:6379
RATE_LIMIT_REDIS_REQUIRED=true
# Query vectors are shared across API instances and invalidated by model/dimension.
QUERY_EMBEDDING_REDIS_CACHE_ENABLED=true
QUERY_EMBEDDING_CACHE_TTL_SECONDS=604800
TRUST_PROXY=1
RATE_LIMIT_TRUST_PROXY_HEADERS=true
# Optional: set this to the single trusted platform header your proxy/CDN controls.
# RATE_LIMIT_CLIENT_IP_HEADER=x-forwarded-for
RATE_LIMIT_DEFAULT_MAX=240
RATE_LIMIT_AI_MAX=24
RATE_LIMIT_UPLOAD_MAX=20
RATE_LIMIT_AUTH_MAX=60

# API/web security headers.
SECURITY_HEADERS_CSP_ENABLED=true
SECURITY_HEADERS_HSTS_ENABLED=true

# Production error reporting. Leave SENTRY_DSN blank for local-only runs.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.1

# Gmail uses the shared Google OAuth connection. Reconnect Google after enabling
# the Gmail API/scope in Google Cloud so existing tokens receive gmail.readonly.

# Compose overrides DATABASE_URL, DIRECT_URL, REDIS_URL, CORS_ORIGIN,
# FRONTEND_URL, API_URL, and API_PUBLIC_URL for container networking.
