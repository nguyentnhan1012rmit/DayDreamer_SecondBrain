{
  "name": "Capstone_DaydreamGroupProject",
  "version": "1.0.0",
  "scripts": {
    "dev": "pnpm --recursive --parallel --if-present run dev",
    "dev:runtime": "pnpm --parallel --filter web --filter @second-brain/api --filter @second-brain/worker dev",
    "build": "pnpm --filter @second-brain/shared build && pnpm --filter @second-brain/db build && pnpm --filter @second-brain/ai build && pnpm --filter @second-brain/api build:app && pnpm --filter @second-brain/worker build && pnpm --filter web build",
    "test": "pnpm --recursive --if-present run test",
    "audit": "pnpm audit --prod --audit-level moderate",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f api worker web",
    "docker:migrate": "docker compose run --rm migrate",
    "db:migrate:deploy": "pnpm --filter @second-brain/db prisma:migrate:deploy",
    "demo:seed": "node --env-file=.env --experimental-strip-types packages/db/scripts/seed-demo.ts",
    "demo:seed:yearly": "node --env-file=.env --experimental-strip-types packages/db/scripts/seed-yearly-view.ts",
    "demo:drain": "pnpm --filter @second-brain/worker indexing:drain",
    "demo:reset-indexing": "pnpm --filter @second-brain/worker indexing:reset-retries",
    "demo:prepare": "pnpm demo:seed && pnpm demo:drain",
    "test:seed:ai-memory": "node --env-file=.env --experimental-strip-types packages/db/scripts/seed-ai-memory-test.ts",
    "perf:seed": "node --env-file=.env --experimental-strip-types packages/db/scripts/seed-performance-datasets.ts",
    "perf:explain": "node --env-file=.env --experimental-strip-types packages/db/scripts/explain-performance-queries.ts",
    "perf:http": "node --env-file=.env --experimental-strip-types packages/db/scripts/benchmark-http.ts",
    "eval:report": "pnpm --filter @second-brain/ai eval:report",
    "eval:memory-report": "pnpm --filter @second-brain/ai eval:prepare-report",
    "eval:memory-report:ci": "pnpm --filter @second-brain/ai eval:report:ci",
    "ci:memory-eval": "pnpm --filter @second-brain/ai eval:smoke:ci",
    "ci:memory-eval:full": "pnpm --filter @second-brain/ai eval:retrieval:ci && pnpm --filter @second-brain/ai eval:answer:ci"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "2.0.10",
      "hono": ">=4.13.5",
      "@babel/core": "7.29.6",
      "fast-uri": ">=3.1.6",
      "form-data": "4.0.6",
      "brace-expansion@<1.1.18": "1.1.18",
      "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
      "brace-expansion@>=4.0.0 <5.0.9": "5.0.9",
      "js-yaml@>=3.0.0 <3.15.1": "3.15.1",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
      "nanoid@<3.3.18": "3.3.18",
      "deepmerge-ts": ">=8.0.0",
      "browserslist": ">=4.28.7",
      "mysql2": ">=3.23.1",
      "baseline-browser-mapping": ">=2.11.0",
      "postcss": "8.5.23",
      "qs": ">=6.16.0",
      "valibot": "1.4.2",
      "ws": "8.21.0",
      "next": ">=16.3.3",
      "multer": ">=2.3.0",
      "sharp": ">=0.35.4",
      "pdfjs-dist": ">=6.2.108"
    }
  }
}
