# =============================================
# .env.example — Copy to .env and fill in values
# =============================================

# === Supabase ===
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# === Database (Prisma) ===
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/postgres

# === Google OAuth ===
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/calendar/oauth/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=your-32-byte-base64-key
GOOGLE_STORE_RAW_PAYLOADS=false
GOOGLE_GMAIL_BODY_MAX_CHARS=20000

# === AI / Tuturuuu ===
TUTURUUU_AI_API_KEY=your-tuturuuu-api-key
TUTURUUU_AI_BASE_URL=https://ai.tuturuuu.com/v1
TUTURUUU_EMBEDDING_MODEL=google/gemini-embedding-2
TUTURUUU_ANSWER_MODEL=google/gemini-3.5-flash-lite
TUTURUUU_CHUNK_MODEL=google/gemini-3.5-flash-lite
TUTURUUU_SUMMARY_MODEL=google/gemini-3.5-flash-lite
TUTURUUU_VISION_MODEL=google/gemini-3.5-flash-lite
AUDIO_TRANSCRIPTION_PROVIDER=tuturuuu

# === URLs ===
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# === Auth ===
AUTH_REQUIRE_EMAIL_VERIFIED=false
ADMIN_REQUIRE_EMAIL_VERIFIED=false
ADMIN_EMAILS=admin@example.com

# === Redis (leave blank to disable caching/rate limiting) ===
REDIS_URL=redis://localhost:6379
SEARCH_REDIS_CACHE_ENABLED=true
QUERY_EMBEDDING_REDIS_CACHE_ENABLED=true
QUERY_EMBEDDING_CACHE_TTL_SECONDS=604800

# === Reverse Proxy (set to 1 or true behind a load balancer) ===
TRUST_PROXY=false

# === Rate Limiting ===
RATE_LIMIT_DEFAULT_MAX=240
RATE_LIMIT_AI_MAX=24
RATE_LIMIT_UPLOAD_MAX=20
RATE_LIMIT_AUTH_MAX=60

# === Timezone ===
APP_TIMEZONE=Asia/Ho_Chi_Minh

# === Sentry (leave DSN blank to disable) ===
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
